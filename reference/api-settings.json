                      "example": "0.11"
                    },
                    "debited_amount": {
                      "type": "string",
                      "description": "Amount debited in this transaction, as a positive decimal string. Debits increase the account balance (e.g. an incoming merchant_order). \"0\" when the transaction is a credit.",
